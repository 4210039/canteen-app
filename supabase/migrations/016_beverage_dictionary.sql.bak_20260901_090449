-- Migration 016: Beverage dictionary
-- Stores known beverages so the app can recognise and split
-- them out of meal descriptions automatically.
-- ═══════════════════════════════════════════════════════════

create table if not exists beverage_dictionary (
  id             uuid primary key default uuid_generate_v4(),
  org_id         uuid not null references organizations(id) on delete cascade,
  name           text not null,          -- canonical name e.g. "mléko"
  aliases        text[] not null default '{}', -- ["mlíko","plnotučné mléko"]
  category       text not null default 'other', -- milk|juice|tea|cocoa|water|other
  ml_per_serving numeric(8,1) not null default 200,
  counts_as_norm boolean not null default false, -- counts toward nutrition norm?
  created_at     timestamptz not null default now(),
  created_by     uuid
);

create index if not exists beverage_dict_org_idx on beverage_dictionary(org_id);
create index if not exists beverage_dict_name_lower_idx on beverage_dictionary(org_id, lower(name));

alter table beverage_dictionary enable row level security;

create policy "beverage_dict_select" on beverage_dictionary for select
  using (org_id = current_user_org_id());
create policy "beverage_dict_insert" on beverage_dictionary for insert
  with check (org_id = current_user_org_id());
create policy "beverage_dict_update" on beverage_dictionary for update
  using (org_id = current_user_org_id());
create policy "beverage_dict_delete" on beverage_dictionary for delete
  using (org_id = current_user_org_id());
