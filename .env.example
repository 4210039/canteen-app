# ── Groq API (free LLM for menu parsing) ────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── Sprint 1: Supabase (database) ───────────────────────────
# Leave blank to run in localStorage-only mode (no cloud persistence).
# Get these from your Supabase project: Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used only by migrate-to-supabase.js — which organization row
# to attach imported localStorage data to. Matches the id seeded
# in supabase/migrations/002_seed_data.sql.
MIGRATION_ORG_ID=00000000-0000-0000-0000-000000000001
